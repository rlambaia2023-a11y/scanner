diff --git a/tests/test_foto_real.py b/tests/test_foto_real.py
new file mode 100644
index 0000000..7ab2b33
--- /dev/null
+++ b/tests/test_foto_real.py
@@ -0,0 +1,86 @@
+"""Ponta a ponta com uma foto real de prova (precisa do Tesseract com português).
+
+Mede o que importa para a correção: a página entra na ordem certa, o PDF fica leve e
+pesquisável, o texto das questões sai legível, e nada fica para trás na pasta temporária."""
+import glob
+import os
+import shutil
+import subprocess
+import tempfile
+
+import pytest
+from PIL import Image
+
+import scanner
+
+FOTO = os.path.join(os.path.dirname(__file__), "fixtures", "prova_pagina.jpg")
+
+
+def tem_por():
+    if not shutil.which("tesseract"):
+        return False
+    langs = subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True).stdout
+    return "por" in langs.split()
+
+
+pytestmark = pytest.mark.skipif(not tem_por(), reason="Tesseract com português não instalado")
+
+
+@pytest.fixture(scope="module")
+def resultado(tmp_path_factory):
+    pasta = tmp_path_factory.mktemp("saida")
+    antes = set(glob.glob(os.path.join(tempfile.gettempdir(), "scan_*")))
+    paginas = scanner.processar([FOTO], str(pasta / "prova.pdf"), silencioso=True)
+    depois = set(glob.glob(os.path.join(tempfile.gettempdir(), "scan_*")))
+    return pasta, paginas, depois - antes
+
+
+def test_folha_recortada_e_ordem_pela_primeira_questao(resultado):
+    _, paginas, _ = resultado
+    assert paginas[0]["recorte"] == "ok"
+    assert paginas[0]["chave"] == ("questao", 3)
+
+
+def test_pdf_compacto_e_pesquisavel(resultado):
+    pasta, _, _ = resultado
+    pdf = pasta / "prova.pdf"
+    assert pdf.stat().st_size < 400 * 1024  # uma página A4 a 200 dpi
+    from pypdf import PdfReader
+    texto = PdfReader(str(pdf)).pages[0].extract_text()
+    assert "oclusão" in texto
+
+
+def test_texto_das_questoes(resultado):
+    pasta, _, _ = resultado
+    txt = (pasta / "prova.txt").read_text(encoding="utf-8")
+    for trecho in ("Dentro do conceito de oclusão", "mordida aberta", "moldagem odontológica",
+                   "principais materiais de moldagem"):
+        assert trecho in txt
+
+
+def test_pasta_temporaria_apagada(resultado):
+    _, _, sobras = resultado
+    assert not sobras
+
+
+def test_foto_de_cabeca_para_baixo(tmp_path):
+    virada = tmp_path / "virada.jpg"
+    Image.open(FOTO).rotate(180, expand=True).save(virada, quality=92)
+    paginas = scanner.processar([str(virada)], str(tmp_path / "v.pdf"), silencioso=True)
+    assert "Dentro do conceito de oclusão" in paginas[0]["texto"]
+
+
+def test_pasta_temporaria_apagada_mesmo_com_erro(tmp_path, monkeypatch):
+    def quebra(*a, **k):
+        raise RuntimeError("falha no meio do OCR")
+
+    monkeypatch.setattr(scanner, "_montar", quebra)
+    antes = set(glob.glob(os.path.join(tempfile.gettempdir(), "scan_*")))
+    with pytest.raises(RuntimeError):
+        scanner.processar([FOTO], str(tmp_path / "x.pdf"), silencioso=True)
+    assert set(glob.glob(os.path.join(tempfile.gettempdir(), "scan_*"))) == antes
+
+
+def test_sem_imagem_da_erro_claro(tmp_path):
+    with pytest.raises(scanner.ErroScanner):
+        scanner.processar([str(tmp_path)], str(tmp_path / "x.pdf"), silencioso=True)
diff --git a/tests/test_ordem.py b/tests/test_ordem.py
new file mode 100644
index 0000000..5516541
--- /dev/null
+++ b/tests/test_ordem.py
@@ -0,0 +1,69 @@
+"""Regras de ordem das páginas (sem OCR: rápido e roda em qualquer máquina)."""
+from datetime import datetime
+
+import scanner
+
+
+def pg(nome, chave, data=None):
+    return {"nome": nome, "chave": chave, "data": data}
+
+
+class TestChaveDaPagina:
+    def test_numero_de_pagina_escrito_ganha(self):
+        assert scanner.chave_da_pagina("Página 2 de 4\n3- Dentro do conceito") == ("pagina", 2)
+
+    def test_formato_barra(self):
+        assert scanner.chave_da_pagina("texto\n 3/5 \n") == ("pagina", 3)
+
+    def test_primeira_questao_da_sequencia(self):
+        assert scanner.chave_da_pagina("8- Assinale\n9- Marque\n10- Explique") == ("questao", 8)
+
+    def test_tolera_uma_questao_que_o_ocr_perdeu(self):
+        # caso real da foto de teste: o "4-" sublinhado some e sobra 3, 5, 6, 7
+        texto = "3- Dentro do conceito\nO estudo da cinesiologia\n5- Em relação\n6- A moldagem\n7- Temos"
+        assert scanner.chave_da_pagina(texto) == ("questao", 3)
+
+    def test_numero_solto_longe_da_sequencia_nao_atrapalha(self):
+        texto = "1- Ano da prova\n12- Questão doze\n13- Questão treze"
+        assert scanner.chave_da_pagina(texto) == ("questao", 12)
+
+    def test_itens_com_salto_dentro_do_enunciado_nao_viram_primeira_questao(self):
+        texto = "15- Considere\n1. Afirmativa\n3. Afirmativa\n16- Próxima\n17- Outra"
+        assert scanner.chave_da_pagina(texto) == ("questao", 15)
+
+    def test_duas_questoes_com_uma_perdida_no_meio(self):
+        assert scanner.chave_da_pagina("3- Dentro\n5- Em relação") == ("questao", 3)
+
+    def test_capa_sem_questao(self):
+        assert scanner.chave_da_pagina("Número de matrícula:\nAluno(a):") == ("capa", 0)
+
+    def test_sem_pista(self):
+        assert scanner.chave_da_pagina("texto qualquer sem número") is None
+
+
+class TestOrdenar:
+    def test_reordena_pela_questao(self):
+        paginas = [pg("a1.jpg", ("questao", 8)), pg("a2.jpg", ("questao", 1)), pg("a3.jpg", ("questao", 4))]
+        assert [p["nome"] for p in scanner.ordenar(paginas)] == ["a2.jpg", "a3.jpg", "a1.jpg"]
+
+    def test_capa_vem_antes(self):
+        paginas = [pg("a1.jpg", ("questao", 1)), pg("a2.jpg", ("capa", 0))]
+        assert [p["nome"] for p in scanner.ordenar(paginas)] == ["a2.jpg", "a1.jpg"]
+
+    def test_pagina_sem_pista_gruda_na_anterior(self):
+        paginas = [pg("f1.jpg", ("questao", 5)), pg("f2.jpg", None), pg("f3.jpg", ("questao", 1))]
+        assert [p["nome"] for p in scanner.ordenar(paginas)] == ["f3.jpg", "f1.jpg", "f2.jpg"]
+
+    def test_nome_em_ordem_natural(self):
+        paginas = [pg("foto10.jpg", None), pg("foto2.jpg", None), pg("foto1.jpg", None)]
+        assert [p["nome"] for p in scanner.ordenar(paginas)] == ["foto1.jpg", "foto2.jpg", "foto10.jpg"]
+
+    def test_exif_define_a_base(self):
+        paginas = [pg("b.jpg", None, datetime(2026, 10, 5, 10, 2)), pg("a.jpg", None, datetime(2026, 10, 5, 10, 1))]
+        assert [p["nome"] for p in scanner.ordenar(paginas)] == ["a.jpg", "b.jpg"]
+        assert [p["nome"] for p in scanner.ordenar(paginas, usar_exif=False)] == ["a.jpg", "b.jpg"]
+
+    def test_numero_de_pagina_prevalece_quando_a_maioria_tem(self):
+        paginas = [pg("x1.jpg", ("pagina", 2)), pg("x2.jpg", ("pagina", 1)), pg("x3.jpg", ("questao", 1))]
+        ordem = [p["nome"] for p in scanner.ordenar(paginas)]
+        assert ordem.index("x2.jpg") < ordem.index("x1.jpg")
diff --git a/tests/test_texto_bot.py b/tests/test_texto_bot.py
new file mode 100644
index 0000000..5076426
--- /dev/null
+++ b/tests/test_texto_bot.py
@@ -0,0 +1,35 @@
+"""Como o bot corta o texto para o botão de copiar (limite de mensagem do Telegram)."""
+import bot
+
+
+def test_separa_questoes_e_junta_a_que_atravessa_a_pagina():
+    paginas = ["Aluno(a): Fulano\n1- Primeira pergunta\nA- alternativa",
+               "continuação da 1\n2- Segunda pergunta\nfaz 90º com o braço"]
+    cabecalho, questoes = bot.separar_questoes(paginas)
+    assert cabecalho == "Aluno(a): Fulano"
+    assert [n for n, _ in questoes] == [1, 2]
+    assert "continuação da 1" in questoes[0][1]
+    assert "90º" in questoes[1][1]
+
+
+def test_numero_menor_dentro_do_enunciado_nao_abre_questao():
+    _, questoes = bot.separar_questoes(["5- Liste:\n1) Primeiro item\n6- Outra"])
+    assert [n for n, _ in questoes] == [5, 6]
+
+
+def test_agrupar_nunca_corta_questao_que_cabe():
+    questoes = [(n, "x" * 1000) for n in range(1, 8)]
+    for parte in bot.agrupar_questoes(questoes, limite=3000):
+        assert sum(len(t) + 2 for _, t in parte) <= 3000
+    numeros = [n for parte in bot.agrupar_questoes(questoes, limite=3000) for n, _ in parte]
+    assert numeros == list(range(1, 8))
+
+
+def test_dividir_respeita_o_limite():
+    blocos = bot.dividir("linha\n" * 2000 + "y" * 7000, limite=3000)
+    assert all(len(b) <= 3000 for b in blocos)
+    assert "".join(blocos).count("y") == 7000
+
+
+def test_limpar_texto_tira_sujeira_de_borda():
+    assert bot.limpar_texto("| \nTexto bom\n\n\n.\nOutro") == "Texto bom\n\nOutro"
